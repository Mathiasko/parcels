{
  "name": "parcels",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist-app/app/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql",
    "build:app": "npm run build && tsc -p tsconfig.app.json",
    "app": "npm run build:app && electron .",
    "app:dist": "npm run build:app && electron-builder --mac",
    "app:smoke": "bash scripts/app/smoke.sh",
    "release": "bash scripts/app/release.sh",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "poll": "node dist/poll.js",
    "serve": "node dist/server.js",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "imapflow": "^2.9.1",
    "luxon": "^3.7.2",
    "mailparser": "^3.12.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
