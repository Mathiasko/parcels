  <entry>
    <category term='filter'></category>
    <title>Mail Filter</title>
    <id>tag:mail.google.com,2008:filter:parcels-1</id>
    <updated>2026-10-27T00:00:00Z</updated>
    <content></content>
    <apps:property name='hasTheWord' value='packeta.sk OR packeta.com OR posta.sk OR gls-group.eu OR sps-sro.sk OR dpd.sk OR odoslana OR odoslane OR odoslany OR odoslanie OR odoslali OR odeslana OR odeslane OR odeslano OR expedovana OR expedovane OR expedovany OR expedovano OR expedovali OR expedicia OR expedujeme OR podana OR podanie OR "na ceste" OR "je na ceste" OR "cislo zasielky" OR "cislo balika" OR "podacie cislo" OR "sledovanie zasielky" OR "sledovat zasielku" OR "sledujte zasielku" OR "stav zasielky" OR "vasa zasielka" OR "vas balik" OR "vase objednavky" OR "pripravena na vyzdvihnutie" OR "na vyzdvihnutie" OR "vyzdvihnite si" OR "k vyzdvihnutiu" OR shipped OR dispatched OR "has been sent" OR "on its way" OR "out for delivery" OR "tracking number" OR "track your parcel" OR "track your order" OR "ready for pickup" OR "ready for collection" OR "shipping confirmation"'/>
    <apps:property name='label' value='parcels'/>
    <apps:property name='sizeOperator' value='s_sl'/>
    <apps:property name='sizeUnit' value='s_smb'/>
  </entry>
