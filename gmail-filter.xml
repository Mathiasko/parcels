  <title>Mail Filters</title>
  <id>tag:mail.google.com,2008:filters:parcels-1</id>
  <updated>2026-10-27T00:00:00Z</updated>
  <author>
    <name>parcels</name>
    <email>parcels@localhost</email>
  </author>
  <entry>
    <category term='filter'></category>
    <title>Mail Filter</title>
    <id>tag:mail.google.com,2008:filter:parcels-1</id>
    <updated>2026-10-27T00:00:00Z</updated>
    <content></content>
    <apps:property name='hasTheWord' value='from:(packeta.sk OR packeta.com OR posta.sk OR slposta.sk OR gls-group.eu OR gls-slovakia.sk OR sps-sro.sk OR dpd.sk OR dhl.com OR dhl.sk OR dhl.de OR dhl.cz OR dhlparcel.com OR dhlparcel.sk OR dhlexpress.com OR allegromail.com OR allegro.sk OR alza.sk OR mtbiker.sk OR aliexpress.com OR zalando.sk OR supersklep.sk OR gymbeam.sk OR lidl-shop.sk OR delivery.hm.com OR skinners.cz) OR subject:(zasielka OR zasielku OR zasielky OR zasielke OR balik OR baliku OR balika OR balicek OR odoslana OR odoslane OR odoslany OR odeslana OR odeslano OR expedovana OR expedovane OR vyzdvihnutie OR vyzdvihnutiu OR "odberne miesto" OR "odbernom mieste" OR "podacie cislo" OR dorazi OR doruceny OR shipped OR dispatched OR "out for delivery" OR "tracking number" OR "track your order" OR "ready for pickup" OR "shipping confirmation")'/>
    <apps:property name='label' value='parcels'/>
    <apps:property name='sizeOperator' value='s_sl'/>
    <apps:property name='sizeUnit' value='s_smb'/>
  </entry>
</feed>
